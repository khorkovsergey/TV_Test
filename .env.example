# Copy to .env for local runs. NEVER commit .env.
# On Railway these are set in the service Variables, not in a file.

# Anthropic API key. Required.
# Issued in the Anthropic console. If a key is ever exposed, revoke it and issue a new one.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres. On Railway, reference the database service: ${{Postgres.DATABASE_URL}}
# If unset, the service starts on in-memory storage (data is lost on restart) —
# acceptable for local checks only.
DATABASE_URL=

# Port. Railway supplies this itself; locally it defaults to 3000.
PORT=3000

# Gate for the consultant desk and the metrics page. Any long random string.
# In PRODUCTION those endpoints now REFUSE (503) when this is unset — the absence
# of a secret is not permission. Locally they stay open so you can work.
# Sent as the x-staff-token header; the query-string form was removed because a
# token in a URL ends up in history, proxy logs and screenshots.
STAFF_TOKEN=

# Model and effort level. Change only deliberately.
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# Search engines. Default is NOT indexed, which is right for a stand that carries
# brand assets it does not own and collects names and emails. Set to true only on
# a deployment genuinely meant to be public.
PUBLIC_INDEX=false

# Acknowledges running production without a database on purpose. Without it, a
# production start with no DATABASE_URL logs three warnings — every enquiry is
# lost on the next restart.
DEMO_EPHEMERAL=false

# Copilot rate limit, requests per minute per address. Writes are capped at 12/min
# and bookings at 6/min; those are not configurable.
COPILOT_RPM=20

# Home A/B split. Off by default: `/` always serves the task home and the control
# stays one ?home=classic away.
HOME_AB=off
