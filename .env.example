# Скопируйте в .env для локального запуска. НИКОГДА не коммитьте .env.
# На Railway эти значения задаются в Variables, а не в файле.

# Ключ Anthropic API. Обязателен.
# Выпускается в консоли Anthropic. Если ключ где-то засветился — отзовите и выпустите новый.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres. На Railway подставляется автоматически при добавлении плагина Postgres.
# Если переменная не задана, сервис поднимется на временном хранилище в памяти
# (данные исчезнут при перезапуске) — это только для локальной проверки.
DATABASE_URL=

# Порт. Railway задаёт его сам, локально по умолчанию 3000.
PORT=3000

# Простая защита кабинета консультанта и страницы метрик.
# Если не задан — доступ открыт (допустимо только локально).
STAFF_TOKEN=

# Модель и уровень усилий. Менять только осознанно.
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
